###############################################################################
# Application secrets. Terraform generates the ones it can and stores them in
# Secrets Manager; External Secrets Operator copies them into the cluster.
# Values also sit in Terraform state, which is why the state bucket is
# encrypted, versioned and private.
###############################################################################

resource "random_password" "db" {
  length  = 40
  special = false # goes into a URL
}

resource "random_password" "redis" {
  length  = 48
  special = false # ElastiCache auth tokens allow only some symbols
}

resource "random_password" "secret_key" {
  length  = 64
  special = false
}

resource "random_password" "admin_staff_key" {
  length  = 32
  special = false
}

resource "random_password" "origin_verify" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "api_generated" {
  name                    = "${local.name}/api/generated"
  description             = "Generated by Terraform. Don't edit by hand; changes are overwritten."
  recovery_window_in_days = local.is_production ? 30 : 0
}

resource "aws_secretsmanager_secret_version" "api_generated" {
  secret_id = aws_secretsmanager_secret.api_generated.id
  secret_string = jsonencode({
    DATABASE_URL         = "postgresql+asyncpg://${aws_db_instance.postgres.username}:${random_password.db.result}@${aws_db_instance.postgres.address}:${aws_db_instance.postgres.port}/${aws_db_instance.postgres.db_name}?ssl=require"
    REDIS_URL            = "rediss://:${random_password.redis.result}@${aws_elasticache_replication_group.redis.primary_endpoint_address}:6379/0"
    SECRET_KEY           = random_password.secret_key.result
    ADMIN_STAFF_KEY      = random_password.admin_staff_key.result
    ORIGIN_VERIFY_SECRET = random_password.origin_verify.result
  })
}

# Keys you add yourself in the console or CLI, for example:
#   aws secretsmanager put-secret-value --secret-id cyberlearn-staging/api/external \
#     --secret-string '{"GEMINI_API_KEY":"...","SENTRY_DSN":"...","SMTP_HOST":"..."}'
# Terraform writes "{}" once and then leaves the value alone.
resource "aws_secretsmanager_secret" "api_external" {
  name                    = "${local.name}/api/external"
  description             = "Third-party keys for the API (Gemini, SMTP, Sentry). Managed by hand."
  recovery_window_in_days = local.is_production ? 30 : 0
}

resource "aws_secretsmanager_secret_version" "api_external" {
  secret_id     = aws_secretsmanager_secret.api_external.id
  secret_string = "{}"

  lifecycle {
    ignore_changes = [secret_string]
  }
}
