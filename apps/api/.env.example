# CyberLearn / Empower API — copy to apps/api/.env

# Local Postgres (docker compose) or a NEW Empower Supabase URI.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://cyberlearn:devpassword@localhost:5432/cyberlearn
# New Supabase project (not an existing marketplace/wallet project):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Set only if local Windows CA verification fails against the pooler:
# SUPABASE_SSL_INSECURE=true

# Redis — set to off if you only need Supabase for /ready
REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-CHANGE-ME-CHANGE-ME-CHANGE-ME-CHANGE-ME-CHANGE-ME-1234

# Office passphrase lives on the API only. Never put this in VITE_*.
ADMIN_STAFF_KEY=

# development | staging | production
ENVIRONMENT=development

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

EDX_LMS_URL=http://localhost:8080
EDX_API_KEY=

CONTENT_DIR=../../content
