# CyberLearn / Empower API — copy to apps/api/.env

# Local Postgres (docker compose) or a NEW Empower Supabase URI.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://cyberlearn:devpassword@localhost:5432/cyberlearn
# New Supabase project (not an existing marketplace/wallet project):
# Set SUPABASE_SSL_INSECURE=true only on broken local Windows CA stores.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SUPABASE_SSL_INSECURE=false

# Cache. Default production path is free in-process MemoryCache:
# REDIS_URL=off
# Optional free hosted Redis protocol (Upstash):
# REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379
# Local Redis / compose --profile redis:
REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-CHANGE-ME-CHANGE-ME-CHANGE-ME-CHANGE-ME-CHANGE-ME-1234

# Office passphrase lives on the API only. Never put this in VITE_*.
ADMIN_STAFF_KEY=

# Public hostname for CORS + nginx (empower.local for lab TLS, your DNS name in prod)
PUBLIC_HOST=empower.local

# development | staging | production
ENVIRONMENT=development

CORS_ORIGINS=["https://empower.local","http://localhost:5173","http://localhost:3000","http://localhost:8080"]

EDX_LMS_URL=http://localhost:8080
EDX_API_KEY=

CONTENT_DIR=../../content

# Request budget (API middleware). 0 disables the timeout.
REQUEST_TIMEOUT_SECONDS=25
# Per-IP sliding windows (shared MemoryCache / Redis). 0 disables a bucket.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=60

# Optional SMTP — leave empty to stay on free mailto / campus inbox.
# Local test inbox (docker compose up -d mailpit) → http://localhost:8025
# If the API runs in Docker use SMTP_HOST=mailpit. If uvicorn is on Windows use 127.0.0.1.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Empower <noreply@empower.local>
SMTP_STARTTLS=false
# Production: Resend (https://resend.com/api-keys) — preferred. Free ~100/day.
# Verify your domain, then set FROM to an address on that domain.
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=Empower <noreply@your-domain.tld>
# Live SMTP instead of Resend:
# Brevo 300/day: smtp-relay.brevo.com:587 + SMTP_STARTTLS=true
# Resend SMTP: smtp.resend.com user=resend password=re_...
# College Google Workspace: smtp.gmail.com:587 + app password
