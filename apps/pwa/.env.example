# PWA environment — copy to apps/pwa/.env.local
# Modes: offline | campus | cloud

VITE_DEPLOYMENT_MODE=campus
VITE_API_URL=/api/v1
VITE_MEDIA_CDN_URL=

# SHA-256 hex of "empower-staff-v1:" + office passphrase. Never bake the passphrase.
# Example: node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('empower-staff-v1:YOUR_KEY')).then(b=>console.log(Buffer.from(b).toString('hex')))"
VITE_ADMIN_STAFF_HASH=

# Optional: new Empower Supabase project URL only (publishable key is public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
