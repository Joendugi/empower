{
  "name": "Empower / CyberLearn",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd /workspace/apps/api && DATABASE_URL=\"sqlite+aiosqlite:///./dev.db\" REDIS_URL=off ENVIRONMENT=development /workspace/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "pwa",
      "command": "cd /workspace/apps/pwa && pnpm dev --host 0.0.0.0"
    }
  ],
  "ports": [8000, 5173]
}
